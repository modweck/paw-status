# Supabase public project configuration.
# Vite exposes only this selected public config through vite.config.js.
# The publishable key is browser-safe only when RLS is correct.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
ENABLE_GROOMER_DASHBOARD=false

# Supabase secret key for trusted scripts only.
# Never expose this in index.html, groomer-dashboard.html, or any public bundle.
SUPABASE_SECRET_KEY=

# Google Places seed script and server-side groomer thumbnails.
GOOGLE_PLACES_API_KEY=

# Twilio SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Prefer Messaging Service SID when available.
TWILIO_MESSAGING_SERVICE_SID=

# Alternative to TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM_NUMBER=

# OneSignal push notifications. Under review; remove if push is not needed.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Public app URL used by notification links.
PUBLIC_APP_URL=

# Server-only admin bootstrap.
# Use this only to seed the first trusted admin path; do not expose to browser code.
ADMIN_BOOTSTRAP_EMAILS=
